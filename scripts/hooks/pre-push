#!/bin/sh
# Block direct pushes to main. The gate is only as strong as the path into the repo: with no
# server-side branch protection (GitHub Pro required for private repos), a stray
# `git push origin main` bypasses every check. Installed by scripts/install_hooks.sh.
#
# pre-push receives the remote name and URL as arguments; the refs to be pushed arrive on
# stdin, one line each: <local ref> <local sha> <remote ref> <remote sha>.
#
# Bypass for a genuine emergency: git push --no-verify origin main
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$remote_ref" ] && continue
    if [ "$remote_ref" = "refs/heads/main" ]; then
        if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
            continue   # creating main for the first time is fine
        fi
        cat >&2 <<'EOF'
refusing to push to main

main only moves by squash-merge of a pull request (scripts/milestone.py merge <n>).
Put your work on a branch:

    python3 scripts/milestone.py start M50b
    python3 scripts/milestone.py submit "M50b: ..."

Emergency override: git push --no-verify origin main
EOF
        status=1
    fi
done
exit $status
